{
  "$comment": "DEMO. Global layer of remote config (docs/13 §5). Bank, agent and device layers override individual keys. Values are checked against schema bounds; integrity-relevant keys need four-eyes approval. Only client-safe values — never secrets.",
  "layer": "global",
  "version": 1,
  "effective_from": "2026-10-01T00:00:00+02:00",
  "values": {
    "maps": { "tile_url": "https://tiles.example.com/{z}/{x}/{y}.png", "api_key": "pk_demo_not_a_real_key", "prefetch_zoom": [14, 17], "wifi_only_prefetch": false },
    "observability": { "sentry_dsn": "https://demo@sentry.example.com/1", "sample_rate": 0.2 },

    "geofence": {
      "$comment": "docs/07 §7 — agreed in principle by the PM 2026-09-11 (D-09). No GPS lock inside → a fix taken immediately outside the premises counts; photos are always required.",
      "sample_seconds": 60,
      "outside_fix": { "allowed": true, "max_accuracy_m": 30, "valid_minutes": 20 },
      "override_radius_multiplier": 2,
      "override_max_m": 500,
      "default_profile": "standalone",
      "profiles": {
        "standalone":      { "label": "Standalone / street-front", "radius_m": 75,  "max_accuracy_m": 30, "exit_consecutive_fixes": 3, "prompt_checkin_on_arrival": false },
        "residential":     { "label": "Home-based / residential",  "radius_m": 75,  "max_accuracy_m": 30, "exit_consecutive_fixes": 3, "prompt_checkin_on_arrival": false },
        "shopping_centre": { "label": "Shopping centre / mall",    "radius_m": 250, "max_accuracy_m": 75, "exit_consecutive_fixes": 5, "prompt_checkin_on_arrival": true },
        "office_park":     { "label": "Office park / business centre / complex", "radius_m": 200, "max_accuracy_m": 75, "exit_consecutive_fixes": 5, "prompt_checkin_on_arrival": true },
        "large_site":      { "label": "Industrial / large site / farm", "radius_m": 300, "max_accuracy_m": 75, "exit_consecutive_fixes": 5, "prompt_checkin_on_arrival": false }
      }
    },

    "integrity":  { "block_on_mock": true, "block_on_root": true, "attestation_max_age_h": 24 },
    "photos":     { "max_long_edge_px": 2048, "jpeg_quality": 80 },
    "auth":       { "reverify_hours": 24, "max_host_token_age_h": 696 },
    "sync":       { "foreground_interval_s": 60, "idle_interval_s": 900, "retain_committed_payload_days": 30 },
    "storage":    { "cap_mb": 500, "block_new_work_at_pct": 80, "tile_cache_mb": 150 },
    "assignment": { "response_timeout_h": 24 },
    "min_module_version": { "nag": "1.0.0", "new_work": "1.0.0" },
    "features":   { "lead_creation": false, "inspection_snapshots": true, "repeatable_groups": true },
    "client_mode": "native",
    "pos":         { "enabled": true },
    "inspections": { "start_enabled": true }
  }
}
