{
  "$comment": "DEMO. Home page (docs/04 §3.6, components docs/11 §7.2). Tiles count local jobs, so they work offline; totals over older history come from the server (stats.*).",
  "spec_version": "1.0",
  "kind": "view",
  "family": "home",
  "scope": { "bank_id": null },
  "version": 1,
  "items": [
    { "type": "greeting", "text": "{{content.home.greeting}}" },

    { "type": "announcement", "source": "announcements", "visible": { "not_empty": [ { "var": "announcements" } ] } },

    { "type": "agent_card_summary", "on_tap": { "page": "agent_card" } },

    { "type": "stat_row", "items": [
      { "type": "stat_tile", "label": "{{content.home.tile_active}}", "on_tap": { "page": "active_jobs" },
        "count": { "source": "jobs", "where": { "in": [ { "var": "job.status" }, ["assigned", "accepted", "in_progress", "paused"] ] } } },
      { "type": "stat_tile", "label": "{{content.home.tile_submitted}}",
        "count": { "source": "jobs", "where": { "in": [ { "var": "job.status" }, ["submitted", "under_review"] ] } } },
      { "type": "stat_tile", "label": "{{content.home.tile_completed_month}}", "on_tap": { "page": "completed_jobs" },
        "value": { "var": "stats.approved_this_month" } },
      { "type": "stat_tile", "label": "{{content.home.tile_due_today}}", "tone": "warning",
        "count": { "source": "jobs", "where": { "and": [
          { "in": [ { "var": "job.status" }, ["assigned", "accepted"] ] },
          { "==": [ { "date_diff": [ { "var": "job.scheduled_start" }, { "today": [] }, "days" ] }, 0 ] } ] } } }
    ] },

    { "type": "sync_status" },

    { "type": "section_title", "text": "{{content.home.today_title}}" },
    { "type": "job_list", "source": "jobs", "limit": 5, "item_view": "job_card", "on_tap": { "page": "job_detail" },
      "where": { "in": [ { "var": "job.status" }, ["assigned", "accepted", "in_progress", "paused"] ] },
      "sort": "job.scheduled_start", "empty_content": "jobs.empty_today" },

    { "type": "action_button", "label": "{{content.home.create_lead}}", "icon": "plus", "page": "create_lead",
      "visible": { "==": [ { "var": "config.features.lead_creation" }, true ] } }
  ]
}
