{
  "$comment": "DEMO. Test cases for the site_inspection family (docs/04 §9). An admin records these from the preview ('save this path as a test case'). Every publish re-runs all of them against the new version in the TS engine; a failure blocks publishing. CI also runs them through the Dart engine so both engines provably agree.",
  "family": "site_inspection",
  "cases": [
    {
      "name": "Wrong address reveals the address field with a map pin",
      "context": { "job": { "location_type": "standalone" }, "inspection": { "geofence": { "profile": "standalone" } } },
      "answers": { "address_matches": false },
      "expect": { "visible": ["actual_address"], "required": ["actual_address"] }
    },
    {
      "name": "Correct address keeps it hidden and out of the submission",
      "context": { "inspection": { "geofence": { "profile": "standalone" } } },
      "answers": { "address_matches": true, "actual_address": { "line1": "stale draft value" } },
      "expect": { "hidden": ["actual_address"], "omitted_from_submission": ["actual_address"] }
    },
    {
      "name": "Premises 'Other' asks for a description",
      "answers": { "premises_type": "other" },
      "expect": { "visible": ["premises_type_other"], "required": ["premises_type_other"] }
    },
    {
      "name": "Private home needs 4 internal photos",
      "answers": { "premises_type": "home", "internal_photos": ["ev_1", "ev_2"] },
      "expect": { "props": { "internal_photos.min_count": 4 }, "errors": ["internal_photos"], "visible": ["home_note"] }
    },
    {
      "name": "Mall profile requires a shopfront photo",
      "context": { "inspection": { "geofence": { "profile": "shopping_centre", "relaxed": true } } },
      "answers": {},
      "expect": { "visible": ["shopfront_photo"], "required": ["shopfront_photo"] }
    },
    {
      "name": "Standalone shop with a GPS lock inside hides the shopfront photo",
      "context": { "inspection": { "geofence": { "profile": "standalone", "method": "inside_fix" } } },
      "answers": {},
      "expect": { "hidden": ["shopfront_photo"] }
    },
    {
      "name": "No GPS lock (outside fix) requires the shopfront photo, even at a standalone shop",
      "context": { "inspection": { "geofence": { "profile": "standalone", "method": "outside_fix" } } },
      "answers": {},
      "expect": { "visible": ["shopfront_photo"], "required": ["shopfront_photo"] }
    },
    {
      "name": "E-commerce and point-of-sale percentages cannot exceed 100%",
      "answers": { "delivered_at_pos": true, "delivered_at_pos_pct": 70, "ecommerce_sales": true, "ecommerce_pct": 40 },
      "expect": { "errors": { "ecommerce_pct": "E-commerce and point-of-sale percentages can't add up to more than 100%." } }
    },
    {
      "name": "Other banks: 'yes' asks which",
      "answers": { "acquired_by_other_banks": true },
      "expect": { "visible": ["other_banks"], "required": ["other_banks"] }
    }
  ],
  "flow_cases": [
    {
      "flow": "site_inspection_flow",
      "name": "Business closed on arrival branches to Unable to complete",
      "answers": { "business_open": false },
      "expect": { "after_step": "arrival", "next": "flow:unable_to_complete_flow" }
    }
  ]
}
