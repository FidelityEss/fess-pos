{
  "$comment": "DEMO. Global default site inspection form, v1. Mirrors the Tuminc–Fidelity paper form (docs/site_inspection_template.pdf). Field #29 (duplicate 'Other businesses') is omitted pending D-12. Rules use the syntax in docs/04 §4; components are from docs/11.",
  "spec_version": "1.0",
  "kind": "form",
  "family": "site_inspection",
  "scope": { "bank_id": null },
  "version": 1,
  "title": "High-Risk Merchant Site Verification",
  "locale": "en-ZA",
  "sections": [
    {
      "key": "arrival",
      "title": "On arrival",
      "fields": [
        { "key": "business_open", "type": "boolean", "display": "yes_no_radio", "required": true,
          "label": "Is the business open, with the owner or a representative available to interview?",
          "help_text": "If not, you'll be taken to 'Unable to complete' — nothing you've captured is lost." }
      ]
    },
    {
      "key": "merchant_profile",
      "title": "Merchant profile",
      "fields": [
        { "key": "inspection_date", "type": "computed", "label": "Date", "value": { "var": "inspection.started_at" }, "props": { "format": "date" } },
        { "key": "merchant_name", "type": "prefilled", "label": "Merchant name", "props": { "source": "job.merchant_name", "allow_flag_differs": true } },
        { "key": "incorporation_date", "type": "date", "label": "Date of incorporation / registration", "required": false,
          "props": { "allow_unknown": true, "max": { "var": "inspection.started_at" } } },
        { "key": "time_in_business", "type": "duration", "label": "How long have you been in business?", "required": true, "props": { "units": ["months", "years"] } },
        { "key": "mcc_code", "type": "prefilled", "label": "Merchant category code", "props": { "source": "job.mcc_code" } },
        { "key": "mcc_description", "type": "prefilled", "label": "Merchant category description", "props": { "source": "job.mcc_description" } },
        { "key": "job_address", "type": "prefilled", "label": "Address on the request", "props": { "source": "job.address" } },
        { "key": "address_matches", "type": "boolean", "display": "yes_no_radio", "required": true, "label": "Is the business at this address?" },
        { "key": "actual_address", "type": "address", "label": "Actual business address", "required": true,
          "visible": { "==": [ { "var": "answers.address_matches" }, false ] },
          "props": { "map_pin": "required", "geocode": "when_online" },
          "fallback": { "type": "textarea" } },
        { "key": "nature_of_business", "type": "textarea", "label": "Nature of business", "required": true, "props": { "min_length": 10 } },
        { "key": "contact_person", "type": "text", "label": "Business contact person", "required": true },
        { "key": "contact_number", "type": "phone", "label": "Business contact number", "required": true, "props": { "default_region": "ZA" } },
        { "key": "business_hours", "type": "business_hours", "label": "Business hours", "required": true,
          "props": { "groups": ["weekdays", "saturday", "sunday", "public_holidays"] } }
      ]
    },
    {
      "key": "payments",
      "title": "Payments",
      "fields": [
        { "key": "payment_methods", "type": "multi_select", "display": "chips", "label": "Payment acceptance methods", "required": true,
          "props": { "min_select": 1, "allow_other": true },
          "options": [
            { "value": "pos", "label": "POS" }, { "value": "ecommerce", "label": "E-commerce" },
            { "value": "qr", "label": "QR code" }, { "value": "wallet", "label": "Wallet" },
            { "value": "eft", "label": "EFT" }, { "value": "cash", "label": "Cash" } ] }
      ]
    },
    {
      "key": "premises",
      "title": "Premises",
      "fields": [
        { "key": "premises_type", "type": "single_select", "display": "dropdown", "label": "Premises type", "required": true,
          "options": [
            { "value": "mall", "label": "Shopping mall" }, { "value": "complex", "label": "Shopping complex" },
            { "value": "office", "label": "Office building" },
            { "value": "home", "label": "Private home", "meta": { "risk": "elevated" } },
            { "value": "other", "label": "Other" } ] },
        { "key": "premises_type_other", "type": "text", "label": "Describe the premises", "required": true,
          "visible": { "==": [ { "var": "answers.premises_type" }, "other" ] } },
        { "key": "external_photos", "type": "photo", "label": "External photographs", "required": true,
          "props": { "category": "external", "min_count": 2, "max_count": 6, "require_gps": true,
                     "guidance": "Stand back far enough to show the entrance and the signage." } },
        { "key": "internal_photos", "type": "photo", "label": "Internal photographs", "required": true,
          "props": { "category": "internal", "max_count": 8, "require_gps": true,
                     "min_count": { "if": [ { "==": [ { "var": "answers.premises_type" }, "home" ] }, 4, 2 ] } } },
        { "key": "home_note", "type": "callout", "tone": "warning",
          "text": "Private-home premises: capture at least 4 internal photographs.",
          "visible": { "==": [ { "var": "answers.premises_type" }, "home" ] } },
        { "key": "shopfront_photo", "type": "photo", "label": "Shopfront / unit photo showing signage and unit number", "required": true,
          "visible": { "or": [
            { "in": [ { "var": "inspection.geofence.profile" }, ["shopping_centre", "office_park"] ] },
            { "==": [ { "var": "inspection.geofence.method" }, "outside_fix" ] } ] },
          "props": { "category": "shopfront", "min_count": 1, "max_count": 2, "require_gps": true } },
        { "key": "other_businesses_present", "type": "boolean", "display": "yes_no_radio", "required": true,
          "label": "Are there other businesses at this location?" },
        { "key": "other_businesses", "type": "repeatable_group", "label": "Other businesses at this location", "required": true,
          "visible": { "==": [ { "var": "answers.other_businesses_present" }, true ] },
          "props": { "min_items": 1, "max_items": 10, "item_label": "{{item.name}}" },
          "fields": [
            { "key": "name", "type": "text", "label": "Business name", "required": true },
            { "key": "description", "type": "text", "label": "What do they do?", "required": false } ] },
        { "key": "property_tenure", "type": "single_select", "display": "segmented", "label": "Is the property owned or leased?", "required": true,
          "options": [ { "value": "owned", "label": "Owned" }, { "value": "leased", "label": "Leased" }, { "value": "unknown", "label": "Unknown" } ] },
        { "key": "square_metres", "type": "number", "label": "Estimated square metres", "required": true, "props": { "min": 1, "max": 100000, "integer": true, "unit": "m²" } },
        { "key": "office_equipment", "type": "textarea", "label": "Visible and available office equipment", "required": true },
        { "key": "equipment_compatible", "type": "boolean", "display": "yes_no_radio", "required": true,
          "label": "Is the equipment compatible with, or necessary for, the nature of the business?" }
      ]
    },
    {
      "key": "risk_indicators",
      "title": "Business activity",
      "fields": [
        { "key": "inventory_sufficient", "type": "boolean", "display": "yes_no_radio", "required": true, "risk_indicator": true,
          "label": "Is the inventory/stock sufficient for the nature of the business?" },
        { "key": "appears_legitimate", "type": "boolean", "display": "yes_no_radio", "required": true, "risk_indicator": true,
          "label": "Does the business appear legitimate?" },
        { "key": "customers_present", "type": "boolean", "display": "yes_no_radio", "required": true, "risk_indicator": true,
          "label": "Are there customers doing business at the premises?" },
        { "key": "acquired_by_other_banks", "type": "boolean", "display": "yes_no_radio", "required": true, "risk_indicator": true,
          "label": "Is there evidence the merchant is currently acquired by other banks?" },
        { "key": "other_banks", "type": "text", "label": "Which bank(s)?", "required": true,
          "visible": { "==": [ { "var": "answers.acquired_by_other_banks" }, true ] } },
        { "key": "delivered_at_pos", "type": "boolean", "display": "yes_no_radio", "required": true,
          "label": "Are goods and services delivered at the point of sale?" },
        { "key": "delivered_at_pos_pct", "type": "percentage", "label": "What percentage is delivered at the point of sale?", "required": true,
          "visible": { "==": [ { "var": "answers.delivered_at_pos" }, true ] } },
        { "key": "ecommerce_sales", "type": "boolean", "display": "yes_no_radio", "required": true, "label": "Are there e-commerce sales?" },
        { "key": "ecommerce_pct", "type": "percentage", "label": "What percentage of sales is e-commerce?", "required": true,
          "visible": { "==": [ { "var": "answers.ecommerce_sales" }, true ] },
          "validate": [
            { "rule": { "<=": [ { "+": [ { "var": ["answers.ecommerce_pct", 0] }, { "var": ["answers.delivered_at_pos_pct", 0] } ] }, 100 ] },
              "message": "E-commerce and point-of-sale percentages can't add up to more than 100%." } ] },
        { "key": "return_policy", "type": "textarea", "label": "Return or refund policy", "required": true },
        { "key": "delivery_policy", "type": "single_select", "display": "segmented", "label": "Delivery policy", "required": true,
          "options": [ { "value": "none", "label": "No delivery" }, { "value": "delivers", "label": "Delivers" } ] },
        { "key": "delivery_days", "type": "number", "label": "Delivery within how many days?", "required": true,
          "visible": { "==": [ { "var": "answers.delivery_policy" }, "delivers" ] }, "props": { "min": 0, "max": 365, "integer": true, "unit": "days" } },
        { "key": "data_security", "type": "textarea", "label": "Data security: how are the terminal, card/personal information and slips kept safe?", "required": true }
      ]
    },
    {
      "key": "interviewee",
      "title": "Person interviewed",
      "fields": [
        { "key": "interviewee_name", "type": "text", "label": "Name", "required": true },
        { "key": "interviewee_designation", "type": "text", "label": "Designation", "required": true },
        { "key": "interviewee_certification", "type": "declaration", "label": "Merchant certification", "required": true,
          "props": { "declaration_key": "merchant_certification" } },
        { "key": "interviewee_signature", "type": "signature", "label": "Signature of person interviewed", "required": true,
          "props": { "signer_name_field": "interviewee_name", "signer_designation_field": "interviewee_designation" } }
      ]
    },
    {
      "key": "agent_declaration",
      "title": "Agent declaration",
      "fields": [
        { "key": "agent_declaration", "type": "declaration", "label": "Agent declaration", "required": true,
          "props": { "declaration_key": "agent_declaration" },
          "help_text": "Declaration text pending from Tuminc (D-12)." }
      ]
    }
  ]
}
