{
  "$comment": "DEMO. Pages and navigation for the agent app (docs/04 §3.6, page types docs/11 §7.1). If this definition ever fails to load or render, the module falls back to the version bundled in the app.",
  "spec_version": "1.0",
  "kind": "app",
  "family": "agent_app",
  "scope": { "bank_id": null },
  "version": 1,
  "home": "home",
  "navigation": {
    "style": "bottom_tabs",
    "items": [
      { "label": "{{content.nav.home}}",  "icon": "home",  "page": "home" },
      { "label": "{{content.nav.leads}}", "icon": "list",  "page": "active_jobs" },
      { "label": "{{content.nav.done}}",  "icon": "check", "page": "completed_jobs" },
      { "label": "{{content.nav.card}}",  "icon": "badge", "page": "agent_card" }
    ]
  },
  "pages": {
    "home": { "type": "view_page", "view": "home" },

    "active_jobs": {
      "type": "list_page", "title": "{{content.pages.active_jobs}}", "source": "jobs",
      "filter": { "in": [ { "var": "job.status" }, ["assigned", "accepted", "in_progress", "paused"] ] },
      "sort": "job.scheduled_start", "group_by": "job.scheduled_day",
      "item_view": "job_card", "on_tap": { "page": "job_detail" }, "empty_content": "jobs.empty_active"
    },

    "completed_jobs": {
      "type": "list_page", "title": "{{content.pages.completed_jobs}}", "source": "jobs",
      "filter": { "in": [ { "var": "job.status" }, ["submitted", "under_review", "approved", "rejected", "unable_to_complete"] ] },
      "sort": "-job.updated_at", "item_view": "job_card", "on_tap": { "page": "job_detail" }, "empty_content": "jobs.empty_completed"
    },

    "job_detail": {
      "type": "view_page", "view": "job_detail",
      "actions": [
        { "label": "{{content.actions.accept}}", "action": "job.accept",
          "visible": { "==": [ { "var": "job.status" }, "assigned" ] } },
        { "label": "{{content.actions.reject}}", "page": "reject_job",
          "visible": { "==": [ { "var": "job.status" }, "assigned" ] } },
        { "label": "{{content.actions.begin}}", "flow": "site_inspection_flow", "style": "primary",
          "visible": { "in": [ { "var": "job.status" }, ["accepted", "in_progress", "paused"] ] } },
        { "label": "{{content.actions.unable}}", "flow": "unable_to_complete_flow",
          "visible": { "in": [ { "var": "job.status" }, ["accepted", "in_progress", "paused"] ] } },
        { "label": "{{content.actions.job_card}}", "page": "job_card" }
      ]
    },

    "job_card":   { "type": "view_page", "view": "job_card" },
    "agent_card": { "type": "view_page", "view": "agent_card" },

    "reject_job": { "type": "form_page", "form": "assignment_reject", "action": "job.reject", "outcomes": "default" },

    "merchant_followup": {
      "$comment": "A brand-new form with zero code: form definition + form_page bound to record.submit.",
      "type": "form_page", "form": "merchant_followup", "action": "record.submit",
      "subject": "job", "outcomes": "default"
    },

    "create_lead": {
      "$comment": "Pending D-38 — what 'create a lead' means.",
      "type": "form_page", "form": "lead_create", "action": "lead.create", "outcomes": "default",
      "visible": { "==": [ { "var": "config.features.lead_creation" }, true ] }
    }
  },
  "outcome_sets": {
    "default": {
      "success": { "icon": "check",  "title": "{{content.outcome.success.title}}", "message": "{{content.outcome.success.message}}",
                   "buttons": [ { "label": "{{content.actions.home}}", "page": "home" } ] },
      "saved":   { "icon": "phone",  "title": "{{content.outcome.saved.title}}",   "message": "{{content.outcome.saved.message}}",
                   "buttons": [ { "label": "{{content.actions.home}}", "page": "home" } ] },
      "failure": { "icon": "alert",  "title": "{{content.outcome.failure.title}}", "message": "{{content.outcome.failure.message}}",
                   "buttons": [ { "label": "{{content.actions.retry}}", "retry": true }, { "label": "{{content.actions.home}}", "page": "home" } ] }
    },
    "inspection": {
      "success": { "icon": "check", "view": "receipt", "title": "{{content.outcome.inspection_success.title}}",
                   "buttons": [ { "label": "{{content.actions.home}}", "page": "home" } ] },
      "saved":   { "icon": "phone", "view": "receipt", "title": "{{content.outcome.inspection_saved.title}}",
                   "message": "{{content.outcome.inspection_saved.message}}",
                   "buttons": [ { "label": "{{content.actions.home}}", "page": "home" } ] },
      "failure": { "icon": "alert", "title": "{{content.outcome.failure.title}}", "message": "{{content.outcome.failure.message}}",
                   "buttons": [ { "label": "{{content.actions.back_to_job}}", "page": "job_detail" } ] }
    }
  }
}
