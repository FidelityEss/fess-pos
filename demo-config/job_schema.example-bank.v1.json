{
  "$comment": "DEMO. Custom job fields for one bank (docs/04 §3.3). They appear in the admin job form and CSV import, show on job_detail, and can drive rules — e.g. high-risk jobs need more photos.",
  "spec_version": "1.0",
  "kind": "job_schema",
  "family": "job_attributes",
  "scope": { "bank_id": "00000000-0000-4000-8000-00000000b001" },
  "version": 1,
  "attributes": [
    { "key": "branch_code", "type": "text", "label": "Bank branch code", "required": true, "props": { "pattern": "^[0-9]{6}$" } },
    { "key": "account_manager", "type": "text", "label": "Bank account manager", "required": false },
    { "key": "risk_tier", "type": "single_select", "label": "Bank risk tier", "required": true,
      "options": [ { "value": "standard", "label": "Standard" }, { "value": "high", "label": "High" } ] }
  ],
  "rule_examples": {
    "$comment": "How a bank's form override could use these, e.g. in its own site_inspection v1 external_photos field:",
    "external_photos.min_count": { "if": [ { "==": [ { "var": "job.attributes.risk_tier" }, "high" ] }, 4, 2 ] }
  }
}
