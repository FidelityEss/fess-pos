{
  "$comment": "DEMO. Three small view definitions in one file for readability; in the system each is its own family and version. Card data and QR tokens always come from POS, never from the host (docs/07 §10).",
  "definitions": [
    {
      "spec_version": "1.0", "kind": "view", "family": "job_card", "scope": { "bank_id": null }, "version": 1,
      "items": [
        { "type": "title", "bind": "job.merchant_name" },
        { "type": "status_chip", "bind": "job.status" },
        { "type": "field_value", "label": "{{content.labels.reference}}", "bind": "job.reference" },
        { "type": "schedule_window", "bind": "job.scheduled" },
        { "type": "address_block", "bind": "job.address", "compact": true },
        { "type": "badge", "text": "{{content.labels.mall}}",
          "visible": { "in": [ { "var": "job.location_type" }, ["shopping_centre", "office_park"] ] } }
      ]
    },
    {
      "spec_version": "1.0", "kind": "view", "family": "job_detail", "scope": { "bank_id": null }, "version": 1,
      "items": [
        { "type": "title", "bind": "job.merchant_name" },
        { "type": "status_chip", "bind": "job.status" },
        { "type": "field_value", "label": "{{content.labels.reference}}", "bind": "job.reference" },
        { "type": "field_value", "label": "{{content.labels.bank}}", "bind": "job.bank_name" },
        { "type": "field_value", "label": "{{content.labels.mcc}}", "bind": "job.mcc_description" },
        { "type": "schedule_window", "bind": "job.scheduled" },
        { "type": "address_block", "bind": "job.address" },
        { "type": "map_preview", "bind": "job.location", "navigate_button": true },
        { "type": "contact", "bind": "job.contact", "actions": ["call", "sms"] },
        { "type": "field_value", "label": "{{content.labels.location_type}}", "bind": "job.location_type_label" },
        { "type": "field_value", "label": "Branch code", "bind": "job.attributes.branch_code",
          "visible": { "not_empty": [ { "var": "job.attributes.branch_code" } ] } },
        { "type": "markdown", "bind": "job.notes", "visible": { "not_empty": [ { "var": "job.notes" } ] } }
      ]
    },
    {
      "spec_version": "1.0", "kind": "view", "family": "agent_card", "scope": { "bank_id": null }, "version": 1,
      "items": [
        { "type": "agent_card", "props": {
          "show": ["photo", "full_name", "employee_number_masked", "role", "authorised_status"],
          "headline": "{{content.card.headline}}",
          "qr": "agent_card_token",
          "offline_note": "{{content.card.offline_note}}" } }
      ]
    }
  ]
}
