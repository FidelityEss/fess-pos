{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fess-pos.invalid/schema/api/answers-document.schema.json",
  "title": "Answers document",
  "description": "docs/04 §5. Carried flat inside the submission and form_submission payloads.",
  "type": "object",
  "properties": {
    "definition_refs": {
      "type": "object",
      "properties": {
        "form": {
          "$ref": "common.schema.json#/$defs/definition_ref"
        },
        "flow": {
          "$ref": "common.schema.json#/$defs/definition_ref"
        },
        "job_schema": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/definition_ref"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "form"
      ],
      "additionalProperties": false
    },
    "config_version_id": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "context_snapshot": {
      "$ref": "common.schema.json#/$defs/context_snapshot"
    },
    "answers": {
      "$ref": "common.schema.json#/$defs/answers"
    },
    "field_timings": {
      "$ref": "common.schema.json#/$defs/field_timings"
    },
    "answers_hash": {
      "$ref": "common.schema.json#/$defs/sha256",
      "description": "sha256(JCS(answers))."
    }
  },
  "required": [
    "definition_refs",
    "context_snapshot",
    "answers",
    "answers_hash"
  ],
  "additionalProperties": false
}
