{
  "name": "fess-brand",
  "version": "1.0.0",
  "description": "FESS / Fidelity Services Group visual language, extracted from the FESS mobile app so the POS module, its phone preview and the admin panel look like FESS. Values marked \"derived\" are POS additions for accessibility (WCAG AA text contrast); everything else is copied from the FESS app.",
  "source": {
    "app": "ess-flutter (FESS mobile app, FlutterFlow) — read-only reference",
    "extracted": "2026-09-12",
    "files": [
      "lib/flutter_flow/flutter_flow_theme.dart (LightModeTheme colours, ThemeTypography)",
      "lib/components/custom_app_bar_widget.dart (page header)",
      "lib/components/modern_menu_item_widget.dart (home menu rows)",
      "lib/pages/home_page/home_page_widget.dart (cards, greeting)",
      "lib/main.dart (ThemeData: Material 2)",
      "flutter_native_splash.yaml (splash colour)",
      "assets/images/Fidelity-logo.png, assets/images/FESSAppIcon_(2).png"
    ]
  },
  "color": {
    "brand": {
      "primary": { "value": "#006B55", "note": "Fidelity green: app bar, primary buttons, splash, logo" },
      "primaryDark": { "value": "#005747", "note": "darkGreen" },
      "primaryLight": { "value": "#029073", "note": "inactivePrimary" },
      "gold": { "value": "#B79E67", "note": "secondary: gold buttons, accents, logo" },
      "goldText": { "value": "#8A7443", "derived": true, "note": "gold for text on white (≈4.5:1); FESS gold on white is ≈2.4:1" }
    },
    "text": {
      "primary": { "value": "#000000" },
      "body": { "value": "#4C4C4C", "note": "most-used literal text colour in FESS" },
      "muted": { "value": "#A3A3A3", "note": "textFieldIcon: chevrons, input icons (not for body text: ≈2.5:1)" },
      "onPrimary": { "value": "#FFFFFF" }
    },
    "background": {
      "page": { "value": "#FFFFFF", "note": "primaryBackground" },
      "home": { "value": "#F6F6F7", "note": "homeBg" },
      "subtle": { "value": "#F7F7F8", "note": "newBackgroundColour" },
      "card": { "value": "#FFFFFF" }
    },
    "line": {
      "divider": { "value": "#E0E3E7", "note": "alternate (dividers, outlines)" },
      "border": { "value": "#DFDFDF", "note": "borderColour" }
    },
    "status": {
      "success": { "value": "#249689" },
      "successBright": { "value": "#25BB48" },
      "warning": { "value": "#F9CF58" },
      "error": { "value": "#FF000E", "note": "icons, borders, fills" },
      "errorText": { "value": "#C4000B", "derived": true, "note": "error text on white (≈5.9:1)" },
      "info": { "value": "#2799FF", "note": "used for location / info accents" }
    },
    "nav": {
      "background": { "value": "#FFFFFF" },
      "active": { "value": "#006B55" },
      "inactive": { "value": "#D8D8D8", "note": "bottomNavIcons" }
    }
  },
  "font": {
    "family": "Montserrat",
    "fallback": ["ui-sans-serif", "system-ui", "-apple-system", "Segoe UI", "Roboto", "Helvetica Neue", "Arial", "sans-serif"],
    "source": "Google Fonts (SIL Open Font License); FESS loads it with google_fonts (1,482 uses)",
    "note": "FESS's custom TTFs (Fesslogo*, Icomoon, …) are icon fonts, not text faces"
  },
  "type": {
    "phone": {
      "headline": { "size": 24, "weight": 500 },
      "titleLarge": { "size": 22, "weight": 600 },
      "title": { "size": 16, "weight": 600 },
      "body": { "size": 14, "weight": 600, "note": "FESS body text is semibold (bodyMedium)" },
      "bodyRegular": { "size": 14, "weight": 400 },
      "caption": { "size": 12, "weight": 400 },
      "button": { "size": 14, "weight": 600 }
    }
  },
  "radius": {
    "control": { "value": 5, "note": "buttons and most boxes (717 uses)" },
    "input": { "value": 8 },
    "card": { "value": 12 },
    "pill": { "value": 30 }
  },
  "shadow": {
    "card": { "value": "0 2px 4px rgba(0, 0, 0, 0.10)" }
  },
  "component": {
    "statusBar": { "background": "color.brand.primary", "foreground": "#FFFFFF" },
    "header": {
      "height": 60,
      "background": "color.brand.primary",
      "paddingX": 32,
      "title": { "size": 16, "weight": 600, "color": "#FFFFFF" },
      "back": { "shape": "circle", "size": 30, "iconSize": 12, "color": "#FFFFFF" }
    },
    "button": {
      "height": 45,
      "radius": "radius.control",
      "primary": { "background": "color.brand.primary", "text": "#FFFFFF" },
      "secondary": { "background": "color.brand.gold", "text": "#FFFFFF", "note": "FESS uses white on gold; POS prefers green primary + outlined green secondary for contrast" },
      "text": { "size": 14, "weight": 600 }
    },
    "card": { "radius": "radius.card", "innerRadius": 8, "shadow": "shadow.card", "background": "color.background.card" },
    "listRow": {
      "height": 80,
      "iconColumn": 70,
      "title": { "size": 14, "weight": 700 },
      "description": { "size": 12, "weight": 400 },
      "chevron": "color.text.muted",
      "divider": "color.line.divider"
    },
    "input": { "radius": "radius.input", "text": "color.text.body", "border": "color.line.divider", "focus": "color.brand.primary" },
    "bottomNav": { "background": "color.nav.background", "active": "color.nav.active", "inactive": "color.nav.inactive" }
  },
  "material": { "useMaterial3": false, "note": "FESS runs Material 2. The POS module brings its own scoped theme (findings/03 §3) built from these tokens." },
  "assets": {
    "logo": "Fidelity Services Group wordmark, green and gold (FESS assets/images/Fidelity-logo.png)",
    "appIcon": "white F mark on green (FESS assets/images/FESSAppIcon_(2).png)"
  }
}
