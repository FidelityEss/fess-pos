{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fess-pos.invalid/schema/definitions/common.schema.json",
  "title": "Shared building blocks for definitions (spec 1.0)",
  "$defs": {
    "key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$",
      "description": "Stable snake_case identifier (field keys, section keys, families, page keys)."
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "spec_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$",
      "description": "major.minor of this specification; engines reject unknown majors and minors newer than they support."
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "scope": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "bank_id": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/uuid"
                }
              ]
            }
          },
          "required": [
            "bank_id"
          ],
          "additionalProperties": false
        }
      ],
      "description": "null or {bank_id: null} = global; {bank_id} = bank override."
    },
    "locale": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"
    },
    "template": {
      "type": "string",
      "maxLength": 2000,
      "description": "Text with {{path}} placeholders, e.g. \"Photos of {{answers.other_business_name}}\"."
    },
    "content_key": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)*$"
    },
    "path": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^[a-z_][a-z0-9_]*(\\.[a-z0-9_]+)*$",
      "description": "Dotted data path, e.g. job.attributes.branch_code."
    },
    "regex": {
      "type": "string",
      "maxLength": 256,
      "description": "Pattern in the RE2-safe subset (schema/rules/operators.json, matches)."
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "time": {
      "type": "string",
      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
    },
    "datetime": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T([01]\\d|2[0-3]):[0-5]\\d(:[0-5]\\d(\\.\\d{1,9})?)?(Z|[+-]([01]\\d|2[0-3]):[0-5]\\d)$",
      "description": "ISO-8601 datetime with offset."
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "asset": {
      "type": "object",
      "properties": {
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "alt": {
          "$ref": "#/$defs/template"
        }
      },
      "required": [
        "sha256"
      ],
      "additionalProperties": false,
      "description": "Content-hashed definition asset, cached offline and verified by hash."
    },
    "target": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "page": {
              "$ref": "#/$defs/key"
            }
          },
          "required": [
            "page"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "flow": {
              "$ref": "#/$defs/key"
            }
          },
          "required": [
            "flow"
          ],
          "additionalProperties": false
        }
      ]
    },
    "expression": {
      "$ref": "../rules/expression.schema.json#/$defs/expression"
    },
    "operation": {
      "$ref": "../rules/expression.schema.json#/$defs/operation"
    },
    "r_boolean": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "$ref": "#/$defs/operation"
        }
      ],
      "description": "R: literal boolean or expression."
    },
    "r_template": {
      "anyOf": [
        {
          "$ref": "#/$defs/template"
        },
        {
          "$ref": "#/$defs/operation"
        }
      ]
    },
    "requires": {
      "type": "object",
      "description": "Computed at publish: spec version and component/step/view/page type versions used (capability negotiation, docs/04 §8).",
      "properties": {
        "spec": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+$"
        },
        "components": {
          "$ref": "#/$defs/version_map"
        },
        "step_types": {
          "$ref": "#/$defs/version_map"
        },
        "view_components": {
          "$ref": "#/$defs/version_map"
        },
        "page_types": {
          "$ref": "#/$defs/version_map"
        }
      },
      "required": [
        "spec"
      ],
      "additionalProperties": false
    },
    "version_map": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    },
    "header_properties": {
      "description": "Properties every definition kind carries (docs/04 §3). Referenced per kind.",
      "type": "object",
      "properties": {
        "spec_version": {
          "$ref": "#/$defs/spec_version"
        },
        "family": {
          "$ref": "#/$defs/key"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "locale": {
          "$ref": "#/$defs/locale"
        },
        "requires": {
          "$ref": "#/$defs/requires"
        }
      }
    }
  }
}
