{
  "spec_version": "1.0",
  "kind": "flow",
  "family": "site_inspection_flow",
  "version": 2,
  "form_family": "site_inspection",
  "action": "inspection.submit",
  "steps": [
    {
      "id": "briefing",
      "type": "job_briefing",
      "view": "job_detail",
      "acknowledgement_text": "I have read the job details"
    },
    {
      "id": "location",
      "type": "location_check",
      "checkin_prompt": "profile",
      "override_form": "geofence_override",
      "messages": {
        "outside": "location.outside_fence"
      }
    },
    {
      "id": "profile",
      "type": "form",
      "sections": [
        "merchant_profile"
      ],
      "paging": "single_page",
      "next": {
        "if": [
          {
            "==": [
              {
                "var": "answers.trading_years"
              },
              0
            ]
          },
          "flow:unable_to_complete_flow",
          "premises"
        ]
      }
    },
    {
      "id": "premises",
      "type": "form",
      "sections": [
        "premises",
        "evidence"
      ],
      "paging": "section_per_page"
    },
    {
      "id": "others",
      "type": "form",
      "sections": [
        "other_businesses_section",
        "interviewee"
      ]
    },
    {
      "id": "review",
      "type": "summary_review",
      "show_risk_indicators": true,
      "allow_jump_back": true
    },
    {
      "id": "declare",
      "type": "declaration",
      "declaration_key": "agent_declaration"
    },
    {
      "id": "submit",
      "type": "submit",
      "label": "Submit inspection",
      "confirm_text": "Submit now?"
    },
    {
      "id": "receipt",
      "type": "receipt",
      "view": "receipt"
    }
  ]
}
