    {
      "name": "0.001° of latitude",
      "expression": {
        "distance_m": [
          {
            "var": "a"
          },
          {
            "var": "b"
          }
        ]
      },
      "data": {
        "a": {
          "lat": -26.1041,
          "lng": 28.0473
        },
        "b": {
          "lat": -26.1031,
          "lng": 28.0473
        }
      },
      "expected": 111.195
