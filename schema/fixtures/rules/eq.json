{
  "operator": "==",
  "cases": [
    {
      "name": "equal numbers",
      "expression": {
        "==": [
          1,
          1
        ]
      },
      "data": {},
      "expected": true
    },
    {
      "name": "no coercion: number vs string",
      "expression": {
        "==": [
          1,
          "1"
        ]
      },
      "data": {},
      "expected": false
    },
    {
      "name": "no coercion: 0 vs false",
      "expression": {
        "==": [
          0,
          false
        ]
      },
      "data": {},
      "expected": false
    },
    {
      "name": "no coercion: empty string vs null",
      "expression": {
        "==": [
          "",
          null
        ]
      },
      "data": {},
      "expected": false
    },
    {
      "name": "null equals null",
      "expression": {
        "==": [
          null,
          null
        ]
      },
      "data": {},
      "expected": true
    },
    {
      "name": "missing var equals null",
      "expression": {
        "==": [
          {
            "var": "missing"
          },
          null
        ]
      },
      "data": {},
      "expected": true
    },
    {
      "name": "deep array equality",
      "expression": {
        "==": [
          [
            1,
            [
              2
            ]
          ],
          [
            1,
            [
              2
            ]
          ]
        ]
      },
      "data": {},
      "expected": true
    },
    {
      "name": "array order matters",
      "expression": {
        "==": [
          [
            1,
            2
          ],
          [
            2,
            1
          ]
        ]
      },
      "data": {},
      "expected": false
    },
    {
      "name": "object key order is irrelevant",
      "expression": {
        "==": [
          {
            "var": "a"
          },
          {
            "var": "b"
          }
        ]
      },
      "data": {
        "a": {
          "x": 1,
          "y": [
            1
          ]
        },
        "b": {
          "y": [
            1
          ],
          "x": 1
        }
      },
      "expected": true
    },
    {
      "name": "IEEE-754: 0.1 + 0.2 is not 0.3",
      "expression": {
        "==": [
          {
            "+": [
              0.1,
              0.2
            ]
          },
          0.3
        ]
      },
      "data": {},
      "expected": false
    },
    {
      "name": "case-sensitive strings",
      "expression": {
        "==": [
          "Abc",
          "abc"
        ]
      },
      "data": {},
      "expected": false
    },
    {
      "name": "one argument",
      "expression": {
        "==": [
          1
        ]
      },
      "data": {},
      "error": "RULE_ARITY"
    },
    {
      "name": "three arguments",
      "expression": {
        "==": [
          1,
          2,
          3
        ]
      },
      "data": {},
      "error": "RULE_ARITY"
    }
  ]
}
