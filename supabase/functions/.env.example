# Local `supabase functions serve --env-file supabase/functions/.env.local` — copy to .env.local.
# No secrets here: signing keys and the worker key live in Vault (generated by the migrations).
POS_ENV=local
# Origin devices/tools use to reach Storage (functions themselves see http://kong:8000 locally).
POS_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Comma-separated admin panel origins allowed by CORS (* = any; bearer tokens only, no cookies).
POS_ADMIN_ORIGINS=*
