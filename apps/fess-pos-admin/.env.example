# FESS POS admin panel — environment (docs/15). One gitignored file per environment:
#   .env.qa         → `pnpm dev:qa`   (http://localhost:3001) — fess-pos-qa, NEXT_PUBLIC_ENV_NAME=qa, NEXT_DIST_DIR=.next-qa
#   .env.production → `pnpm dev:prod` (http://localhost:3002) — fess-pos,    NEXT_PUBLIC_ENV_NAME=production, NEXT_DIST_DIR=.next-prod
# On Vercel the same variables are set per project (docs/15 §6); NEXT_DIST_DIR is local-only and ignored there.
# The values below are placeholders from the retired local Docker stack (a public demo key, not a secret).

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
NEXT_PUBLIC_POS_API_URL=http://127.0.0.1:54321/functions/v1/api
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# local | qa | production — drives the environment banner and hides Dev tools in production.
NEXT_PUBLIC_ENV_NAME=local
