{
  "name": "@fess-pos/engine",
  "version": "0.1.0",
  "description": "FESS POS TypeScript engine: JCS hashing, rules engine, definition parser, resolver, validator, publish analyser and API contract types. Runs unchanged in Deno, Node 20+ and browsers.",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "deno:check": "deno check --config deno.json src/index.ts"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^3.2.4",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
