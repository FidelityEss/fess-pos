          "sql": "CREATE TABLE IF NOT EXISTS \"jobs\" (\"id\" TEXT NOT NULL, \"reference\" TEXT NOT NULL, \"status\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"assigned_to_me\" INTEGER NOT NULL DEFAULT 0 CHECK (\"assigned_to_me\" IN (0, 1)), \"bank_id\" TEXT NULL, \"scheduled_start_ms\" INTEGER NULL, \"body\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
