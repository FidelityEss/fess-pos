      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"outbox\" (\"id\" TEXT NOT NULL, \"device_seq\" INTEGER NOT NULL UNIQUE, \"type\" TEXT NOT NULL, \"type_version\" INTEGER NOT NULL, \"lane\" INTEGER NOT NULL, \"user_id\" TEXT NULL, \"envelope\" TEXT NOT NULL, \"payload_hash\" TEXT NOT NULL, \"bytes\" INTEGER NOT NULL, \"state\" TEXT NOT NULL, \"receipt_state\" TEXT NULL, \"receipt\" TEXT NULL, \"last_error\" TEXT NULL, \"attempts\" INTEGER NOT NULL DEFAULT 0, \"next_attempt_ms\" INTEGER NULL, \"entity_ref\" TEXT NULL, \"created_at\" TEXT NOT NULL, \"created_at_ms\" INTEGER NOT NULL, \"updated_at\" TEXT NOT NULL, \"committed_at_ms\" INTEGER NULL, PRIMARY KEY (\"id\"));"
